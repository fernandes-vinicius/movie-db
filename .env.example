# ----------------------------------------------------------------
# movie-db — Environment Variables
# ----------------------------------------------------------------
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in the values below
# 3. Never commit .env.local to version control
# ----------------------------------------------------------------

# TMDB API Key
# Get yours for free at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_api_key_here

# TMDB Base URL (no need to change this)
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB Image Base URL (no need to change this)
# Usage: ${VITE_TMDB_IMAGE_BASE_URL}/w300/{poster_path}
# Sizes: w92 | w154 | w185 | w342 | w500 | w780 | original
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
